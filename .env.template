# Estas variables se comparten con varios servicios mediante el docker.compose.prod

# Puerto del host donde se expone el gateway
CLIENT_GATEWAY_PORT=3000

# Contraseña de PostgreSQL compartida por los microservicios
DB_PASSWORD=

# Nombre de la base de datos usada por los microservicios
DB_DATABASE=microservice3

# Host del servidor PostgreSQL
DB_HOST=localhost

# Puerto del servidor PostgreSQL
DB_PORT=5433

# Usuario de PostgreSQL
DB_USERNAME=postgres

# Activa o desactiva synchronize en los servicios que lo usan
DB_SYNCHRONIZE=false

# URL del servidor NATS para la comunicacion entre microservicios
NATS_SERVERS="nats://nats-server-dev:4222"

# Ambiente de ejecucion permitido: prod o dev
ENVIRONMENT=dev

# La autenticación web es opcional; Auth-Service inicia sin esta infraestructura cuando vale false.
WEB_AUTH_ENABLED=false
WEB_REDIS_PASSWORD=
REDIS_PORT=6379
KEYCLOAK_PORT=8080

# Keycloak usa su propia configuración PostgreSQL y no reutiliza automáticamente las variables DB_*.
KC_DB=postgres
KC_DB_URL_HOST=
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_HEALTH_ENABLED=true

# Hostname de desarrollo. Los valores productivos están en .env.production.template.
KC_HOSTNAME=http://localhost:8080

# Se usa únicamente para crear el administrador inicial cuando todavía no existe uno.
KC_BOOTSTRAP_ADMIN_USER=
KC_BOOTSTRAP_ADMIN_PASSWORD=
