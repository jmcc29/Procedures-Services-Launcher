# Variables compartidas por los servicios del launcher backend en desarrollo.

# Puerto del host donde se expone Gateway-Service.
CLIENT_GATEWAY_PORT=3000

# Conexión PostgreSQL compartida por los microservicios.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=microservice3

# Activa o desactiva synchronize en los servicios que todavía lo usan.
DB_SYNCHRONIZE=false

# URL interna de NATS para la comunicación entre microservicios.
NATS_SERVERS="nats://nats-server-dev:4222"

# Ambiente de ejecución permitido: prod o dev.
ENVIRONMENT=dev

# Activa la autenticación web SID/OIDC/UMA.
WEB_AUTH_ENABLED=false


# Puertos publicados localmente para Redis y Keycloak.
REDIS_PORT=6379
KEYCLOAK_PORT=8080
