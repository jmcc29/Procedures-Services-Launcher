# Archivo central del launcher backend para producción.

# Archivo central que cada microservicio cargará después de su .env.compose.
PLATFORM_ENV_FILE=.env.production


# Puerto público donde el host expone Gateway-Service.
CLIENT_GATEWAY_PORT=3000

# Ambiente de ejecución compartido por los microservicios.
ENVIRONMENT=prod

# Conexión PostgreSQL compartida por los servicios funcionales.
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Impide que TypeORM modifique automáticamente los schemas en producción.
DB_SYNCHRONIZE=false

# Servidor NATS interno utilizado por Gateway y los microservicios.
NATS_SERVERS=nats://nats-server:4222

# Activa la autenticación web SID/OIDC/UMA.
WEB_AUTH_ENABLED=true

# Puerto y dirección local donde se publica Keycloak para el proxy inverso.
KEYCLOAK_PORT=8080
KEYCLOAK_BIND_ADDRESS=127.0.0.1
