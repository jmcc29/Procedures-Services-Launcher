# Archivo central del launcher backend para producción.

# Archivo central que cada servicio cargará después de su .env.compose.
PLATFORM_ENV_FILE=.env.production

# Puerto público donde el host expone Gateway-Service.
CLIENT_GATEWAY_PORT=3000

# Ambiente de ejecución compartido por los microservicios.
ENVIRONMENT=prod

# Conexión PostgreSQL compartida por los servicios que usan estas variables.
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Impide que TypeORM modifique automáticamente los schemas en producción.
DB_SYNCHRONIZE=false

# Servidor NATS interno utilizado por Gateway y los microservicios.
NATS_SERVERS=nats://nats-server:4222

# Activa la autenticación web SID/OIDC/UMA.
WEB_AUTH_ENABLED=true

# Contraseña de Redis usada por Redis y Auth-Service.
WEB_REDIS_PASSWORD=

# Puerto reservado para Redis si se necesitara una exposición controlada.
# El Compose productivo actual no publica Redis al host.
REDIS_PORT=6379

# Conexión interna de Auth-Service con Redis.
WEB_REDIS_HOST=redis
WEB_REDIS_PORT=6379

# Prefijo que separa las claves de sesión de esta plataforma.
WEB_REDIS_KEY_PREFIX=muserpol-web

# Duración máxima del estado previo al callback OIDC, en segundos.
WEB_PENDING_TTL_SECONDS=600

# Duración absoluta de la sesión web, en segundos.
WEB_SESSION_TTL_SECONDS=28800

# Duración máxima por inactividad, en segundos.
WEB_SESSION_IDLE_TTL_SECONDS=7200

# Margen previo a expiración para renovar tokens, en segundos.
WEB_REFRESH_SKEW_SECONDS=120

# Emisor público exacto que debe aparecer en los tokens de Keycloak.
OIDC_ISSUER=https://keycloak.example.test/realms/muserpol

# Origen interno con el que Auth-Service alcanza Keycloak desde Compose.
OIDC_INTERNAL_BASE_URL=http://keycloak:8080

# Clave interna y cliente OIDC asignados al Hub.
OIDC_HUB_TOOL_KEY=hub
OIDC_HUB_CLIENT_ID=hub-interface

# Tipo del cliente Hub: public o confidential.
OIDC_HUB_CLIENT_TYPE=confidential

# Secreto requerido únicamente cuando el cliente Hub es confidential.
OIDC_HUB_CLIENT_SECRET=

# Callback exacto permitido después del login OIDC.
OIDC_HUB_CALLBACK_URL=https://hub.example.test/api/auth/callback

# Destino exacto permitido después del logout global.
OIDC_HUB_POST_LOGOUT_REDIRECT_URL=https://hub.example.test/

# Catálogo administrado de herramientas; Auth deriva la audiencia y el servidor de recursos de clientId.
WEB_CLIENT_CATALOG={"beneficiary":{"clientId":"beneficiary-interface"},"sales":{"clientId":"sales-interface"},"collections":{"clientId":"collections-interface"}}

# Puerto y dirección local donde se publica Keycloak para el proxy inverso.
KEYCLOAK_PORT=8080
KEYCLOAK_BIND_ADDRESS=127.0.0.1

# Conexión de Keycloak con su base y schema exclusivos.
KC_DB=postgres
KC_DB_URL_HOST=
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=
KC_DB_PASSWORD=

# Habilita los endpoints internos de salud de Keycloak.
KC_HEALTH_ENABLED=true

# Permite HTTP únicamente entre Keycloak y el proxy o la red interna.
KC_HTTP_ENABLED=true

# Indica qué encabezados del proxy inverso debe interpretar Keycloak.
KC_PROXY_HEADERS=xforwarded

# URL HTTPS pública y canónica de Keycloak.
KC_HOSTNAME=https://keycloak.example.test

# Rechaza hostnames que no coincidan con la URL canónica.
KC_HOSTNAME_STRICT=true

# Credenciales usadas solo para crear el administrador inicial.
KC_BOOTSTRAP_ADMIN_USER=
KC_BOOTSTRAP_ADMIN_PASSWORD=
